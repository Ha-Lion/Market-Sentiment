#!/usr/bin/env python3
"""Build the Phase 1 Market Pulse facts from stored PublicSentimentDash data.

This stage is intentionally deterministic. AI wording can later consume the
selected facts, but it never chooses or changes the underlying measurements.
"""

from __future__ import annotations

import argparse
import json
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


SCHEMA = "publicsentimentdash.market-pulse.v1"

def source_priority(item: dict[str, Any], registry: dict[str, dict[str, Any]]) -> int:
    embedded = item.get("source_priority")
    if embedded is not None:
        try:
            return max(1, min(3, int(embedded)))
        except (TypeError, ValueError):
            pass
    source = str(item.get("source") or "").strip().lower()
    return int(registry.get(source, {}).get("priority", 3) or 3)


def load(path: Path) -> dict[str, Any]:
    with path.open("r", encoding="utf-8") as handle:
        value = json.load(handle)
    if not isinstance(value, dict):
        raise ValueError(f"{path} must contain a JSON object")
    return value


def number(value: Any) -> float | None:
    try:
        result = float(value)
        return result if result == result else None
    except (TypeError, ValueError):
        return None


def label(score: float) -> str:
    if score >= 75:
        return "Strong Bullish"
    if score >= 60:
        return "Bullish"
    if score > 40:
        return "Mixed/Neutral"
    if score > 25:
        return "Bearish"
    return "Strong Bearish"


def close_from(entry: dict[str, Any]) -> float | None:
    technical = entry.get("technical") if isinstance(entry.get("technical"), dict) else {}
    history = technical.get("daily_history") if isinstance(technical.get("daily_history"), list) else []
    closes = [number(row.get("close")) for row in history if isinstance(row, dict)]
    closes = [value for value in closes if value is not None]
    if closes:
        return closes[-1]
    daily = technical.get("daily") if isinstance(technical.get("daily"), dict) else {}
    return number(daily.get("close"))


def price_change(entry: dict[str, Any]) -> float | None:
    technical = entry.get("technical") if isinstance(entry.get("technical"), dict) else {}
    history = technical.get("daily_history") if isinstance(technical.get("daily_history"), list) else []
    closes = [number(row.get("close")) for row in history if isinstance(row, dict)]
    closes = [value for value in closes if value is not None]
    if len(closes) < 2 or closes[-2] == 0:
        return None
    return round((closes[-1] - closes[-2]) / closes[-2] * 100, 2)


def compact_news(entry: dict[str, Any], source_registry: dict[str, dict[str, Any]], limit: int = 12) -> list[dict[str, Any]]:
    output = []
    candidates = [item for item in entry.get("top_headlines", []) if isinstance(item, dict)]
    candidates.sort(key=lambda item: str(item.get("published_utc") or ""), reverse=True)
    candidates.sort(key=lambda item: (
        source_priority(item, source_registry),
        0 if str(item.get("impact") or "").lower() == "high" else 1,
    ))
    for item in candidates:
        if not isinstance(item, dict) or not item.get("title"):
            continue
        output.append({
            "title": str(item.get("title") or "").strip(),
            "source": str(item.get("source") or "Source").strip(),
            "source_url": str(source_registry.get(str(item.get("source") or "").strip().lower(), {}).get("url") or ""),
            "link": str(item.get("link") or "").strip(),
            "published_utc": str(item.get("published_utc") or "").strip(),
            "vote": str(item.get("vote") or "Neutral").strip(),
            "impact": str(item.get("impact") or "Normal").strip(),
            "priority": source_priority(item, source_registry),
        })
        if len(output) >= limit:
            break
    return output


def chart_histories(records: list[dict[str, Any]], key: str, latest: dict[str, Any]) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    sentiment = []
    for record in records:
        entry = record.get("instruments", {}).get(key)
        score = number(entry.get("psi")) if isinstance(entry, dict) else None
        date = str(record.get("date") or "")[:10]
        if date and score is not None:
            sentiment.append({"date": date, "value": round(score, 1)})

    technical = latest.get("technical") if isinstance(latest.get("technical"), dict) else {}
    daily_history = technical.get("daily_history") if isinstance(technical.get("daily_history"), list) else []
    market = []
    for item in daily_history:
        if not isinstance(item, dict):
            continue
        date = str(item.get("date") or "")[:10]
        close = number(item.get("close"))
        if date and close is not None:
            market.append({"date": date, "value": round(close, 6)})
    return sentiment, market


def asset_meta(config: dict[str, Any]) -> dict[str, dict[str, str]]:
    result: dict[str, dict[str, str]] = {}
    for asset in config.get("assets", []):
        if not isinstance(asset, dict):
            continue
        key = str(asset.get("name") or "").strip()
        market_data = asset.get("market_data") if isinstance(asset.get("market_data"), dict) else {}
        categories = [item for item in asset.get("categories", []) if isinstance(item, dict) and item.get("enabled") is not False]
        primary = next((item for item in categories if item.get("role") == "primary"), categories[0] if categories else {})
        if key:
            result[key] = {
                "display_name": str(market_data.get("label") or asset.get("display_name") or key).strip(),
                "symbol": str(asset.get("symbol") or "").strip(),
                "category": str(primary.get("category") or asset.get("type") or "other").strip(),
                "related_page": str(primary.get("page") or "dashboard.html").strip(),
            }
    return result


def explanation(row: dict[str, Any]) -> str:
    change = row["change_1d"]
    price = row["price_change_1d_pct"]
    if row["is_divergence"]:
        return "Sentiment and price moved in opposite directions, a disagreement worth monitoring for confirmation or reversal."
    if row["is_reversal"]:
        return "Sentiment crossed the neutral 50 level with a large daily move, marking a meaningful change in the public narrative."
    if row["is_extreme"]:
        return "The PSI reading is near a historical scale extreme, so follow-through and headline breadth deserve attention."
    if abs(change) >= 15:
        return "Public sentiment changed sharply in one day, making this one of today’s most notable narrative shifts."
    if price is not None and abs(price) >= 2:
        return "The market price also moved materially, providing useful context for the sentiment change."
    return "This qualified change is supported by the minimum headline sample and ranks among today’s stronger shifts."


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--history", default="instrument_history_compact.json")
    parser.add_argument("--dashboard", default="dashboard_live.json")
    parser.add_argument("--assets", default="assets_config.json")
    parser.add_argument("--sources", default="sources.json")
    parser.add_argument("--output", default="market_pulse.json")
    args = parser.parse_args()

    history = load(Path(args.history))
    dashboard = load(Path(args.dashboard))
    config = load(Path(args.assets))
    source_config = json.loads(Path(args.sources).read_text(encoding="utf-8")) if Path(args.sources).exists() else []
    source_registry = {}
    for item in source_config:
        if not isinstance(item, dict) or not item.get("name") or not item.get("url") or item.get("enabled") is False:
            continue
        keys = [item.get("name"), *(item.get("aliases") if isinstance(item.get("aliases"), list) else [])]
        for key in keys:
            normalized = str(key or "").strip().lower()
            if normalized:
                source_registry[normalized] = item
    records = [row for row in history.get("records", []) if isinstance(row, dict) and isinstance(row.get("instruments"), dict)]
    if len(records) < 2:
        raise ValueError("At least two instrument-history records are required")

    records.sort(key=lambda row: str(row.get("date") or ""))
    current, previous = records[-1], records[-2]
    seven_target = records[max(0, len(records) - 8)]
    metadata = asset_meta(config)
    rows: list[dict[str, Any]] = []

    for key, latest in current["instruments"].items():
        if not isinstance(latest, dict):
            continue
        prior = previous["instruments"].get(key)
        week = seven_target["instruments"].get(key)
        if not isinstance(prior, dict):
            continue
        score = number(latest.get("psi"))
        prior_score = number(prior.get("psi"))
        week_score = number(week.get("psi")) if isinstance(week, dict) else None
        headlines = int(number(latest.get("headline_count")) or 0)
        # Very small headline samples can create misleading 0/100 swings.
        if score is None or prior_score is None or headlines < 5:
            continue
        one_day = round(score - prior_score, 1)
        seven_day = round(score - week_score, 1) if week_score is not None else None
        px_change = price_change(latest)
        meta = metadata.get(key, {})
        sentiment_chart, market_chart = chart_histories(records, key, latest)
        row = {
            "instrument": key,
            "display_name": meta.get("display_name", key),
            "symbol": meta.get("symbol", ""),
            "category": meta.get("category", "other"),
            "related_page": meta.get("related_page", "dashboard.html"),
            "psi": round(score, 1),
            "sentiment_label": str(latest.get("sentiment_label") or label(score)),
            "change_1d": one_day,
            "change_7d": seven_day,
            "headline_count": headlines,
            "price_close": close_from(latest),
            "price_change_1d_pct": px_change,
            "is_reversal": (score >= 50 > prior_score or score < 50 <= prior_score) and abs(one_day) >= 8,
            "is_extreme": score >= 75 or score <= 25,
            "is_divergence": px_change is not None and abs(one_day) >= 3 and abs(px_change) >= 0.5 and one_day * px_change < 0,
            "latest_news": compact_news(latest, source_registry),
            "sentiment_history": sentiment_chart,
            "market_history": market_chart,
        }
        row["why_it_matters"] = explanation(row)
        rows.append(row)

    ranked = sorted(rows, key=lambda row: (abs(row["change_1d"]), row["headline_count"]), reverse=True)
    movers = ranked[:12]
    reversals = [row for row in ranked if row["is_reversal"]][:4]
    extremes = sorted((row for row in rows if row["is_extreme"]), key=lambda row: abs(row["psi"] - 50), reverse=True)[:4]
    divergences = [row for row in ranked if row["is_divergence"]][:4]
    highlights = []
    for row in movers[:5]:
        direction = "rose" if row["change_1d"] > 0 else "fell"
        highlights.append({
            "instrument": row["instrument"],
            "text": f"{row['display_name']} sentiment {direction} {abs(row['change_1d']):g} points to {row['psi']:g}/100.",
            "facts": {"psi": row["psi"], "change_1d": row["change_1d"], "headline_count": row["headline_count"]},
            "why_it_matters": row["why_it_matters"],
        })

    global_psi = number(current.get("global_psi")) or number(dashboard.get("headline_psi_score"))
    previous_global = number(previous.get("global_psi"))
    rising = sum(1 for row in rows if row["change_1d"] > 0)
    falling = sum(1 for row in rows if row["change_1d"] < 0)
    unchanged = len(rows) - rising - falling
    breadth = round((rising / max(1, rising + falling)) * 100)
    regional = dashboard.get("regional_pulse") if isinstance(dashboard.get("regional_pulse"), dict) else {}
    regions = {}
    for region_key in ("global", "us", "europe"):
        region = regional.get(region_key) if isinstance(regional.get(region_key), dict) else {}
        score = number(region.get("score"))
        regions[region_key] = {
            "psi": score,
            "sentiment_label": str(region.get("label") or (label(score) if score is not None else "Unavailable")),
            "headline_count": int(number(region.get("count")) or 0),
            "confidence": str(region.get("confidence") or "Unavailable"),
        }
    regions["global"]["change_1d"] = round(global_psi - previous_global, 1) if global_psi is not None and previous_global is not None else None
    payload = {
        "schema": SCHEMA,
        "status": "laboratory",
        "generated_utc": datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC"),
        "data_updated_utc": dashboard.get("updated_utc") or current.get("updated_utc"),
        "data_updated_ny": dashboard.get("updated_ny") or current.get("updated_ny"),
        "comparison": {"current_date": current.get("date"), "previous_date": previous.get("date"), "seven_day_reference": seven_target.get("date")},
        "global": {"psi": global_psi, "sentiment_label": label(global_psi) if global_psi is not None else "Unavailable", "change_1d": round(global_psi - previous_global, 1) if global_psi is not None and previous_global is not None else None},
        "regions": regions,
        "market_breadth": {"rising": rising, "falling": falling, "unchanged": unchanged, "bullish_share_pct": breadth},
        "selection_rules": {"minimum_headlines": 5, "reversal_min_points": 8, "extreme_psi": [0, 25, 75, 100], "divergence_min_sentiment_points": 3, "divergence_min_price_pct": 0.5},
        "top_movers": movers,
        "reversals": reversals,
        "extremes": extremes,
        "divergences": divergences,
        "universe": sorted(rows, key=lambda row: (row["category"], row["display_name"])),
        "highlights": highlights,
        "traceability": {"sentiment_source": Path(args.history).name, "current_record_date": current.get("date"), "dashboard_source": Path(args.dashboard).name, "ai_generated": False},
    }
    output = Path(args.output)
    temp = output.with_suffix(output.suffix + ".tmp")
    temp.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    temp.replace(output)
    print(f"Wrote {output} with {len(rows)} eligible instruments and {len(movers)} movers")


if __name__ == "__main__":
    main()
